  "lines": [
    {
      "markup": "いつの間にか{いつのまにか}|来{き}た|ね",
      "zh": "不知不觉间，我们来到了这里",
      "aside": false
    },
    {
      "markup": "こんな|遠{とお}い|ところ|まで",
      "zh": "来到了这么远的地方",
      "aside": false
    },
    {
      "markup": "ああ |空{そら}|は|いつも|の|青{あお}い|空{そら}",
      "zh": "啊，天空依旧是熟悉的蓝天",
      "aside": false
    },
    {
      "markup": "何{なに}|も|なかった|から",
      "zh": "因为曾经一无所有",
      "aside": false
    },
    {
      "markup": "何{なに}か|つかみたい|想{おも}い|が",
      "zh": "那份想要抓住些什么的心意",
      "aside": false
    },
    {
      "markup": "ああ |道{みち}|を|作{つく}ってくれた|の|かな",
      "zh": "啊，或许为我们开辟了道路吧",
      "aside": false
    },
    {
      "markup": "キセキ|は|起{お}こる|と|知{し}った|よ",
      "zh": "我明白了，奇迹是会发生的",
      "aside": false
    },
    {
      "markup": "あの|頃{ころ}|の|僕{ぼく}ら|へ|と|教{おし}えてあげたい",
      "zh": "真想把这件事告诉那时的我们",
      "aside": false
    },
    {
      "markup": "あきらめない|こと|が|夢{ゆめ}|へ|の|手{て}がかり|だ|と",
      "zh": "不放弃就是通向梦想的线索",
      "aside": false
    },
    {
      "markup": "今{いま}|だから|言{い}ってもいい|かな|言{い}いたい|ね",
      "zh": "到了现在，可以这样说了吧，真想说出来呢",
      "aside": false
    },
    {
      "markup": "迷{まよ}い|に|揺{ゆ}れる|こころ|それでも|前{まえ}|を|向{む}いて",
      "zh": "虽然内心因迷茫而动摇，我们仍然面向前方",
      "aside": false
    },
    {
      "markup": "やまない|雨{あめ}|は|ない|と|走って来た{はしってきた}|よ",
      "zh": "相信没有不会停的雨，我们就这样一路奔跑而来",
      "aside": false
    },
    {
      "markup": "だから|ね|サンシャイン|見上{みあ}げれば|熱{あつ}い|太陽{たいよう}",
      "zh": "所以啊，阳光——抬头就能看见炽热的太阳",
      "aside": false
    },
    {
      "markup": "ひとり|から|ふたり|へ",
      "zh": "从一个人到两个人",
      "aside": false
    },
    {
      "markup": "ふたり|から|みんな|の|中{なか}|に",
      "zh": "再从两个人传到大家心中",
      "aside": false
    },
    {
      "markup": "ああ |伝{つた}わってくれた|夢{ゆめ}|の|鼓動{こどう}",
      "zh": "啊，梦想的心跳就这样传递开来",
      "aside": false
    },
    {
      "markup": "何{なに}|も|なかった|のに",
      "zh": "明明曾经一无所有",
      "aside": false
    },
    {
      "markup": "何{なに}か|できる|気{き}|が|してた|よ",
      "zh": "却觉得自己能够做成些什么",
      "aside": false
    },
    {
      "markup": "ああ |大胆{だいたん}|すぎた|かな|でも|頑張{がんば}れた",
      "zh": "啊，也许是太大胆了吧，但我们确实努力过了",
      "aside": false
    },
    {
      "markup": "キセキ|が|起{お}こった|ね|キセキ|が|本当{ほんとう}|に",
      "zh": "奇迹发生了呢，奇迹真的发生了",
      "aside": false
    },
    {
      "markup": "悩{なや}んでた|僕{ぼく}ら|へ|と|教{おし}えてあげたい",
      "zh": "真想把这件事告诉曾经烦恼的我们",
      "aside": false
    },
    {
      "markup": "投げ出したい{なげだしたい}|時{とき}|こそ|大{おお}きく|変{か}わる|時{とき}|さ",
      "zh": "正是想要放弃的时候，才是发生重大改变的时候",
      "aside": false
    },
    {
      "markup": "そこ|に|きっと|チャンス|が|ある|から|あった|から",
      "zh": "因为那里一定有机会，也确实曾有过机会",
      "aside": false
    },
    {
      "markup": "動{うご}いてない|と|探{さが}せない|休{やす}んでも|止{と}まらないで",
      "zh": "不行动就无法寻找，即使休息，也不要就此停下",
      "aside": false
    },
    {
      "markup": "明{あ}けない|夜{よる}|は|ない|と|走{はし}ってきた|ね",
      "zh": "相信没有不会迎来黎明的黑夜，我们就这样一路奔跑而来呢",
      "aside": false
    },
    {
      "markup": "そう|だ|よ|サンシャイン|いつだって|熱{あつ}い|太陽{たいよう}",
      "zh": "是啊，阳光——无论何时，太阳都如此炽热",
      "aside": false
    },
    {
      "markup": "ヒカリ |ユウキ |ミライ|歌{うた}|に|すれば",
      "zh": "光芒、勇气、未来——只要唱成歌",
      "aside": false
    },
    {
      "markup": "照{て}れくさい|言葉{ことば}|だって|届{とど}けられる|から",
      "zh": "就连难为情的话语，也能够传达出去",
      "aside": false
    },
    {
      "markup": "大{おお}きな|声{こえ}|で",
      "zh": "放声唱出来吧！",
      "aside": false
    },
    {
      "markup": "あきらめない|こと|が|夢{ゆめ}|へ|の|手{て}がかり|だ|と",
      "zh": "不放弃就是通向梦想的线索",
      "aside": false
    },
    {
      "markup": "今{いま}|だから|言{い}ってもいい|かな|言{い}いたい|ね",
      "zh": "到了现在，可以这样说了吧，真想说出来呢",
      "aside": false
    },
    {
      "markup": "迷{まよ}い|に|揺{ゆ}れる|こころ|それでも|前{まえ}|を|向{む}いて",
      "zh": "虽然内心因迷茫而动摇，我们仍然面向前方",
      "aside": false
    },
    {
      "markup": "やまない|雨{あめ}|は|ない|と|走って来た{はしってきた}|よ",
      "zh": "相信没有不会停的雨，我们就这样一路奔跑而来",
      "aside": false
    },
    {
      "markup": "だから|ね|サンシャイン|見上{みあ}げれば|熱{あつ}い|太陽{たいよう}",
      "zh": "所以啊，阳光——抬头就能看见炽热的太阳",
      "aside": false
    },
    {
      "markup": "動{うご}いてない|と|探{さが}せない|休{やす}んでも|止{と}まらないで",
      "zh": "不行动就无法寻找，即使休息，也不要就此停下",
      "aside": false
    },
    {
      "markup": "夜{よる}|が|明{あ}けた|空{そら}|に|は|太陽{たいよう}",
      "zh": "夜色褪去，天空中是太阳……！",
      "aside": false
    }
