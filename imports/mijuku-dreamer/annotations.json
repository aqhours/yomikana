  "lines": [
    {
      "markup": "いつも|そば|に|いても",
      "zh": "即使一直在身边",
      "aside": false
    },
    {
      "markup": "伝{つた}えきれない|想{おも}い|で　|こころ|迷子{まいご}|に|なる",
      "zh": "仍有传达不尽的心意，让心迷失了方向",
      "aside": false
    },
    {
      "markup": "ナミダ|忘{わす}れてしまおう",
      "zh": "就把泪水忘掉吧",
      "aside": false
    },
    {
      "markup": "歌{うた}ってみよう　|いっしょ|に|ね",
      "zh": "试着一起唱歌吧",
      "aside": false
    },
    {
      "markup": "言葉{ことば}|だけ|じゃ|足{た}りない",
      "zh": "光靠言语还不够",
      "aside": false
    },
    {
      "markup": "そう|言葉{ことば}|すら|足{た}りない|故{ゆえ}|に　|すれ違{ちが}って",
      "zh": "是啊，正因为连言语都不够，才产生了误解",
      "aside": false
    },
    {
      "markup": "離{はな}れてしまった|こと|が",
      "zh": "就这样彼此疏远",
      "aside": false
    },
    {
      "markup": "悲{かな}しかった|の　|ずっと|気{き}|に|なってた",
      "zh": "让我很难过，一直放在心上",
      "aside": false
    },
    {
      "markup": "わかって欲しい{わかってほしい}|と|願{ねが}う",
      "zh": "希望你能够理解我",
      "aside": false
    },
    {
      "markup": "キモチ|が|とまらなくて　|きっと|傷{きず}つけた|ね",
      "zh": "这份心情无法抑制，一定伤害了你吧",
      "aside": false
    },
    {
      "markup": "それでも|あきらめきれない",
      "zh": "即便如此，还是无法彻底放弃",
      "aside": false
    },
    {
      "markup": "自分{じぶん}|の|ワガママ　|いま|は|隠{かく}さない|から",
      "zh": "因为现在，我不会再隐藏自己的任性",
      "aside": false
    },
    {
      "markup": "力{ちから}|を|あわせて |夢{ゆめ}|の|海{うみ}|を|泳{およ}いで|行{い}こう|よ",
      "zh": "齐心协力，在梦想的海洋里游下去吧",
      "aside": false
    },
    {
      "markup": "今日{きょう}|の|海{うみ}|を…！",
      "zh": "就在今天的这片海洋里……！",
      "aside": false
    },
    {
      "markup": "どんな|未来{みらい}|か|は　|誰{だれ}|も|まだ|知{し}らない",
      "zh": "未来会是什么样，谁都还不知道",
      "aside": false
    },
    {
      "markup": "でも|楽{たの}しくなる|はず|だ|よ",
      "zh": "但一定会变得快乐的",
      "aside": false
    },
    {
      "markup": "みんな|と|なら　|乗{の}りこえられる",
      "zh": "和大家一起，就能跨越困难",
      "aside": false
    },
    {
      "markup": "これから|なんだ|ね　|お互い{おたがい}|がんばろう|よ",
      "zh": "一切才刚开始呢，我们一起努力吧",
      "aside": false
    },
    {
      "markup": "どんな|未来{みらい}|か|は　|誰{だれ}|も|まだ|知{し}らない",
      "zh": "未来会是什么样，谁都还不知道",
      "aside": false
    },
    {
      "markup": "でも|楽{たの}しくしたい|ホント|に",
      "zh": "但真的想让它变得快乐",
      "aside": false
    },
    {
      "markup": "みんな|と|なら　|無理{むり}|したくなる",
      "zh": "和大家一起，就想挑战自己的极限",
      "aside": false
    },
    {
      "markup": "成長{せいちょう}|したい|な　|まだまだ|未熟{みじゅく}|DREAMER",
      "zh": "想要成长啊，我们还是尚未成熟的梦想家",
      "aside": false
    },
    {
      "markup": "やっと|ひとつ|に|なれそう|な|僕{ぼく}たち|だから",
      "zh": "因为我们终于快要成为一体了",
      "aside": false
    },
    {
      "markup": "本音{ほんね}|ぶつけあう|とこ|から|始{はじ}めよう",
      "zh": "就从坦诚地说出彼此的真心话开始吧",
      "aside": false
    },
    {
      "markup": "その|時{とき}|見{み}える|光{ひかり}|が|ある|はず|さ",
      "zh": "到那时，一定会有能看见的光芒",
      "aside": false
    },
    {
      "markup": "このまま|一緒{いっしょ}|に　|夢{ゆめ}|の|海{うみ}|を|泳{およ}いで|行{い}こう|よ",
      "zh": "就这样一起，在梦想的海洋里游下去吧",
      "aside": false
    },
    {
      "markup": "今日{きょう}|の|海{うみ}|を…！",
      "zh": "就在今天的这片海洋里……！",
      "aside": false
    },
    {
      "markup": "嵐{あらし}|が|きたら　|晴{は}れる|まで|遊{あそ}ぼう",
      "zh": "风暴来了，就玩到天晴吧",
      "aside": false
    },
    {
      "markup": "歌{うた}えば|きっと|楽{たの}しい|はず|さ",
      "zh": "唱起歌来，一定会很快乐",
      "aside": false
    },
    {
      "markup": "ひとり|じゃない　|乗{の}りこえられる",
      "zh": "我们并非独自一人，能跨越困难",
      "aside": false
    },
    {
      "markup": "不思議{ふしぎ}|な|くらい|怖{こわ}く|は|なくなって",
      "zh": "竟然变得不再害怕，连自己都觉得不可思议",
      "aside": false
    },
    {
      "markup": "嵐{あらし}|が|きたら　|晴{は}れる|まで|遊{あそ}ぼう",
      "zh": "风暴来了，就玩到天晴吧",
      "aside": false
    },
    {
      "markup": "それ|も|楽{たの}しみ|だ|ね|ホント|さ",
      "zh": "那也很值得期待呢，是真的",
      "aside": false
    },
    {
      "markup": "ひとり|じゃない　|無理{むり}|しないで|よ",
      "zh": "我们并非独自一人，别勉强自己啊",
      "aside": false
    },
    {
      "markup": "助{たす}けあえば|いい　|わくわく|未熟{みじゅく}|DREAMER",
      "zh": "互相帮助就好，我们是满怀期待、尚未成熟的梦想家",
      "aside": false
