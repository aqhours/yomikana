  "lines": [
    {
      "markup": "消{き}えない|ユメ|の|桜{さくら}　|ひらり|ひらり　|舞{ま}う|よ",
      "zh": "不会消失的梦想之樱，轻轻地、轻轻地飞舞着",
      "aside": false
    },
    {
      "markup": "消{き}えない|ユメ|は|桜{さくら}　|空{そら}|を|舞{ま}い|ミライ|へ",
      "zh": "不会消失的梦想化作樱花，在空中飞舞，向着未来",
      "aside": false
    },
    {
      "markup": "誰{だれ}|も|が|知{し}ってる|けど　|その|日{ひ}|まで|気{き}づかない|んだ",
      "zh": "虽然谁都知道，却直到那一天才察觉",
      "aside": false
    },
    {
      "markup": "出会{であ}い|の|先{さき}|に|待{ま}っている　|あたらしい|季節{きせつ}",
      "zh": "在相遇之后等待着的，是新的季节",
      "aside": false
    },
    {
      "markup": "昨日{きのう}|まで|ツボミ|でも　|咲き誇{さきほこ}って|こぼれそう|だ",
      "zh": "即使直到昨天还是花蕾，如今也盛放得仿佛要满溢出来",
      "aside": false
    },
    {
      "markup": "香{かお}り|は|春{はる}|を|歌{うた}ってる？　|なぜか|泣{な}けてくる",
      "zh": "花香在歌唱春天吗？不知为何，眼泪涌了上来",
      "aside": false
    },
    {
      "markup": "淡{あわ}い　|淡{あわ}い　|淡{あわ}い|花{はな}|が|空{そら}|を|見{み}たがったら",
      "zh": "如果浅浅的、浅浅的、浅色的花想看看天空",
      "aside": false
    },
    {
      "markup": "旅{たび}|しよう|遠{とお}く|へ　|飛{と}んでみよう",
      "zh": "就向远方旅行吧，试着飞翔吧",
      "aside": false
    },
    {
      "markup": "まだ|熱{あつ}き|ココロ|が|とまらない",
      "zh": "炽热的心仍停不下来",
      "aside": false
    },
    {
      "markup": "いつか|思い出{おもいで}|に|変{か}わる|って|こと|が　|わかんない|まま|で",
      "zh": "还不明白，这一切总有一天会变成回忆",
      "aside": false
    },
    {
      "markup": "ああ|桜{さくら}、|サクラ|よ！　|永遠{えいえん}|に|咲{さ}きたかろう？",
      "zh": "啊，樱花，樱花啊！你也想永远绽放吧？",
      "aside": false
    },
    {
      "markup": "なんで|イマ|は|過{す}ぎてく|んだろう",
      "zh": "为什么此刻总要流逝呢",
      "aside": false
    },
    {
      "markup": "満開{まんかい}|よ　|ずっと|続{つづ}け|と|願{ねが}い|ながら|目{め}|を|閉{と}じる",
      "zh": "闭上眼睛，祈愿这满开的花一直盛放下去",
      "aside": false
    },
    {
      "markup": "香{かお}り|は|いつか|幻{まぼろし}　|でも|ね|忘{わす}れない",
      "zh": "花香终有一天会变得虚幻，可我不会忘记",
      "aside": false
    },
    {
      "markup": "好{す}き　|好{す}き　|好{す}き　|好{す}き|な|言葉{ことば}|届{とど}けよう",
      "zh": "喜欢，喜欢，喜欢，把喜欢的话语传达出去吧",
      "aside": false
    },
    {
      "markup": "楽{たの}しい|気持{きも}ち|で　|会{あ}いたい|んだ|よ",
      "zh": "想带着快乐的心情与你相见啊",
      "aside": false
    },
    {
      "markup": "ただ|想{おも}い|の|強{つよ}さ|伝{つた}われば",
      "zh": "只要这份强烈的心意能传达给你",
      "aside": false
    },
    {
      "markup": "いつか|思い出{おもいで}|に|変{か}わった|とき|も　|さみしくない|ね",
      "zh": "总有一天变成回忆时，也不会寂寞了吧",
      "aside": false
    },
    {
      "markup": "ああ|桜{さくら}、|サクラ|よ！　|イマ|が|通り過ぎる{とおりすぎる}|まえ|に|もっと…",
      "zh": "啊，樱花，樱花啊！在此刻流逝之前，再多一些……",
      "aside": false
    },
    {
      "markup": "ほんの|一瞬{いっしゅん}|かさなった|時間{じかん}|が|愛{いと}しい",
      "zh": "哪怕只有一瞬，交叠在一起的时光也令人眷恋",
      "aside": false
    },
    {
      "markup": "つかめそう|で　|つかめなくて　|胸{むね}|に|は|香{かお}り|だけ|が|残{のこ}る|の|かな",
      "zh": "似乎能抓住，却又抓不住，心中会只剩下花香吗",
      "aside": false
    },
    {
      "markup": "なつかしい|香{かお}り|だけ|が",
      "zh": "只剩下那令人怀念的花香",
      "aside": false
    },
    {
      "markup": "でも|想{おも}い|の|強{つよ}さ|伝{つた}われば",
      "zh": "可是，只要这份强烈的心意能传达给你",
      "aside": false
    },
    {
      "markup": "思い出{おもいで}|に|変{か}わっても　|楽{たの}しい|よ|きっと！",
      "zh": "即使变成回忆，也一定会快乐的！",
      "aside": false
    },
    {
      "markup": "まだ|熱{あつ}き|ココロ|が|とまらない",
      "zh": "炽热的心仍停不下来",
      "aside": false
    },
    {
      "markup": "いつか|思い出{おもいで}|に|変{か}わる|って|こと|が　|わかんない|まま|で",
      "zh": "还不明白，这一切总有一天会变成回忆",
      "aside": false
    },
    {
      "markup": "ああ|桜{さくら}、|サクラ|よ！　|永遠{えいえん}|に|咲{さ}きたかろう？",
      "zh": "啊，樱花，樱花啊！你也想永远绽放吧？",
      "aside": false
    },
    {
      "markup": "なんで|イマ|は|過{す}ぎてく|んだろう",
      "zh": "为什么此刻总要流逝呢",
      "aside": false
    },
    {
      "markup": "消{き}えない|ユメ|の|桜{さくら}　|ひらり|ひらり　|舞{ま}う|よ",
      "zh": "不会消失的梦想之樱，轻轻地、轻轻地飞舞着",
      "aside": false
