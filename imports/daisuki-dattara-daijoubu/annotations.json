  "lines": [
    {
      "markup": "キラリ！",
      "zh": "闪闪发光！",
      "aside": false
    },
    {
      "markup": "ときめき|が|生{う}まれた|んだ|と",
      "zh": "察觉到心动已经萌生",
      "aside": false
    },
    {
      "markup": "気{き}|が|ついた|ワケ|は　|目{め}|の|まえ|の|キミ|だって|こと|さ",
      "zh": "是因为眼前的你啊",
      "aside": false
    },
    {
      "markup": "\"やってみたい\"",
      "zh": "“想试试看”",
      "aside": false
    },
    {
      "markup": "動{うご}きだした|心{こころ}|は　|まだ|迷{まよ}い|を|かかえて|揺{ゆ}れている|よ",
      "zh": "开始行动的心，仍带着迷茫摇摆不定",
      "aside": false
    },
    {
      "markup": "それでも|スタート|した|の|は|運命{うんめい}|かな",
      "zh": "即便如此还是迈出了第一步，是命运吗",
      "aside": false
    },
    {
      "markup": "気持{きも}ち|が|つながりそう|なんだ",
      "zh": "彼此的心意似乎就要相通了",
      "aside": false
    },
    {
      "markup": "知{し}らない|こと|ばかり　|なにもかも|が|（どうしたら|いい|の？）",
      "zh": "尽是不了解的事，一切都是如此（该怎么办才好？）",
      "aside": false
    },
    {
      "markup": "それでも|期待{きたい}|で|足{あし}|が|軽{かる}い|よ|（ジャンプ|だ！）",
      "zh": "即便如此，期待仍让脚步轻快起来（跳起来！）",
      "aside": false
    },
    {
      "markup": "温度差{おんどさ}|なんて|いつか|消{け}しちゃえ|って|ね",
      "zh": "彼此热情的差距，总有一天要消除啊",
      "aside": false
    },
    {
      "markup": "元気{げんき}|だ|よ　|元気{げんき}|を|だしていく|よ",
      "zh": "打起精神吧，要精神满满地前进啊",
      "aside": false
    },
    {
      "markup": "キラリ！",
      "zh": "闪闪发光！",
      "aside": false
    },
    {
      "markup": "ときめき|が|生{う}まれた|んだ|と",
      "zh": "当我察觉到心动已经萌生",
      "aside": false
    },
    {
      "markup": "気{き}|が|ついた|とき|に|（いた|んだ|よ）|目{め}|の|まえ|に|キミ|が|いた",
      "zh": "就在那时（你就在这里），你出现在我眼前",
      "aside": false
    },
    {
      "markup": "キラリ！",
      "zh": "闪闪发光！",
      "aside": false
    },
    {
      "markup": "あつくなる|自分{じぶん}|見{み}つけた|よ",
      "zh": "发现了满怀热情的自己",
      "aside": false
    },
    {
      "markup": "この|ひかり|は|（きれい|だ|よ|ね）|もっと|キラリ|（まぶしい|希望{きぼう}）",
      "zh": "这道光（真漂亮啊），更加闪耀（耀眼的希望）",
      "aside": false
    },
    {
      "markup": "ダイスキ|が|あれば|ダイジョウブ|さ",
      "zh": "只要心怀热爱，就没问题",
      "aside": false
    },
    {
      "markup": "\"やってみよう\"",
      "zh": "“试试看吧”",
      "aside": false
    },
    {
      "markup": "決{き}めた|の|は|どうして|か|を　|説明{せつめい}|できる|言葉{ことば}|は|つたない|けど",
      "zh": "虽然还不能好好用言语说明，为什么做出了这个决定",
      "aside": false
    },
    {
      "markup": "とにかく|スタート|させなきゃ|後悔{こうかい}|しちゃう",
      "zh": "总之，不开始行动就会后悔",
      "aside": false
    },
    {
      "markup": "ムリヤリ|飛{と}びだせ　|なんとか|しよう",
      "zh": "硬着头皮冲出去吧，总会想出办法的",
      "aside": false
    },
    {
      "markup": "計画{けいかく}|は|これから　|どこ|いこう|かな|（だれ|と|いける|かな？）",
      "zh": "计划从现在开始，要去哪里呢（能和谁一起去呢？）",
      "aside": false
    },
    {
      "markup": "いままで|見{み}た|こと|ない|夢{ゆめ}|の|ステージ|（チャンス|だ！）",
      "zh": "从未见过的梦想舞台（机会来了！）",
      "aside": false
    },
    {
      "markup": "尻込{しりご}み|なんて|する|の|やめちゃえ|って|さ",
      "zh": "别再畏缩不前了啊",
      "aside": false
    },
    {
      "markup": "勇気{ゆうき}|だ|よ　|勇気{ゆうき}|は|万能{ばんのう}|ハイパワー",
      "zh": "拿出勇气吧，勇气是万能的强大力量",
      "aside": false
    },
    {
      "markup": "ピカリ！",
      "zh": "灵光一闪！",
      "aside": false
    },
    {
      "markup": "アイデア|が|ひらめいたら",
      "zh": "有了灵感的话",
      "aside": false
    },
    {
      "markup": "広{ひろ}げてみたい|よ|ね|（大{おお}きく）|キミ|だって|無視{むし}|できない",
      "zh": "就想试着拓展开来吧（大大地），连你也无法忽视",
      "aside": false
    },
    {
      "markup": "ピカリ！",
      "zh": "灵光一闪！",
      "aside": false
    },
    {
      "markup": "思いつき{おもいつき}|でも|楽{たの}しくて",
      "zh": "即使是一时的念头，也让人开心",
      "aside": false
    },
    {
      "markup": "ほら|勢{いきお}い|（ついた|はず|さ）|だから|ピカリ|（さらなる|野望{やぼう}）",
      "zh": "看，这股冲劲（应该已经有了吧），所以灵光一闪（更进一步的抱负）",
      "aside": false
    },
    {
      "markup": "ダイスキ|で|いつも|ダイジョウブ|さ",
      "zh": "有热爱在，就总会没问题",
      "aside": false
    },
    {
      "markup": "知{し}らない|こと|ばかり　|なにもかも|が",
      "zh": "尽是不了解的事，一切都是如此",
      "aside": false
    },
    {
      "markup": "それでも|期待{きたい}|で|足{あし}|が|軽{かる}い|よ",
      "zh": "即便如此，期待仍让脚步轻快起来",
      "aside": false
    },
    {
      "markup": "温度差{おんどさ}|なんて|いつか|消{け}しちゃえ|って|ね",
      "zh": "彼此热情的差距，总有一天要消除啊",
      "aside": false
    },
    {
      "markup": "元気{げんき}|だ|よ　|元気{げんき}|を|だしていく|よ",
      "zh": "打起精神吧，要精神满满地前进啊",
      "aside": false
    },
    {
      "markup": "キラリ！　|ピカリ！",
      "zh": "闪闪发光！灵光一闪！",
      "aside": false
    },
    {
      "markup": "ときめき|が|生{う}まれた|んだ|と",
      "zh": "当我察觉到心动已经萌生",
      "aside": false
    },
    {
      "markup": "気{き}|が|ついた|とき|に|（いた|んだ|よ）|目{め}|の|まえ|に|キミ|が|いた",
      "zh": "就在那时（你就在这里），你出现在我眼前",
      "aside": false
    },
    {
      "markup": "キラリ！",
      "zh": "闪闪发光！",
      "aside": false
    },
    {
      "markup": "あつくなる|自分{じぶん}|見{み}つけた|よ",
      "zh": "发现了满怀热情的自己",
      "aside": false
    },
    {
      "markup": "この|ひかり|は|（きれい|だ|よ|ね）|もっと|キラリ|（まぶしい|希望{きぼう}）",
      "zh": "这道光（真漂亮啊），更加闪耀（耀眼的希望）",
      "aside": false
    },
    {
      "markup": "ダイスキ|が|あれば|ダイジョウブ|さ",
      "zh": "只要心怀热爱，就没问题",
      "aside": false
