  "lines": [
    {
      "markup": "あたらしい|言葉{ことば}|たち　|なつかしい|歌{うた}|へ|と",
      "zh": "新的话语，融入令人怀念的歌中",
      "aside": false
    },
    {
      "markup": "重{かさ}なって|なんか|もっと　|違{ちが}う|感じかた{かんじかた}|が|生{う}まれそう|だ|よ",
      "zh": "彼此交叠，仿佛会生出更加不同的感受",
      "aside": false
    },
    {
      "markup": "それ|は|出会{であ}い|から　|いままで|の|大切{たいせつ}|な|想{おも}い",
      "zh": "那是从相遇至今珍藏的心意",
      "aside": false
    },
    {
      "markup": "どんな|時{とき}|だって|ココロ　|つながっていたくて",
      "zh": "无论何时，都想让心意彼此相连",
      "aside": false
    },
    {
      "markup": "人生{じんせい}|の|偶然{ぐうぜん}|で|君{きみ}|と|僕{ぼく}|が　|ひとつ|の|星{ほし}|に|いる|なら",
      "zh": "如果人生中的偶然，让你我身处同一颗星球",
      "aside": false
    },
    {
      "markup": "絆{きずな}|って|こと|かな？　|ステキ|な|偶然{ぐうぜん}|だ|ね",
      "zh": "这就是所谓的羁绊吗？真是美好的偶然啊",
      "aside": false
    },
    {
      "markup": "みんな|みんな|楽{たの}しい|こと　|探{さが}す|旅{たび}|の|途中{とちゅう}|さ",
      "zh": "大家都在寻找快乐的旅途中",
      "aside": false
    },
    {
      "markup": "そう|なんだ！",
      "zh": "是这样啊！",
      "aside": false
    },
    {
      "markup": "ここ|から|近{ちか}く|の　|ここ|から|遠{とお}く|の|どこか|で　|また|会{あ}おう",
      "zh": "在离这里近些或远些的某个地方，再相会吧",
      "aside": false
    },
    {
      "markup": "みんな|みんな|楽{たの}しい|こと　|探{さが}す|旅{たび}|の|途中{とちゅう}|だから",
      "zh": "因为大家都在寻找快乐的旅途中",
      "aside": false
    },
    {
      "markup": "たくさん|冒険{ぼうけん}|して　|次{つぎ}|に|語{かた}りあえる|時{とき}|が",
      "zh": "经历许多冒险后，下次能与彼此畅谈的时刻",
      "aside": false
    },
    {
      "markup": "待ち遠しい{まちどおしい}|よ！",
      "zh": "真让人迫不及待啊！",
      "aside": false
    },
    {
      "markup": "いつの間にか{いつのまにか}|だったり　|いつも|の|こと|だったり",
      "zh": "有时在不知不觉间，有时已成了日常",
      "aside": false
    },
    {
      "markup": "そば|に|いて欲しい{いてほしい}|って|思{おも}ってくれたら　|キモチ|は|同{おな}じ|色{いろ}",
      "zh": "如果你也希望我在身边，我们的心意便是同一种颜色",
      "aside": false
    },
    {
      "markup": "つまり|出会{であ}い|の|意味{いみ}|は　|一緒{いっしょ}|に|いる|こと|さ",
      "zh": "也就是说，相遇的意义就是在一起",
      "aside": false
    },
    {
      "markup": "ずっと|ずっと|変{か}わらない　|つながっていよう|よ",
      "zh": "永远都不改变，就这样一直相连吧",
      "aside": false
    },
    {
      "markup": "人生{じんせい}|は|挑戦{ちょうせん}|で|君{きみ}|は|僕{ぼく}|は　|ユメ|を|見{み}つけ|走{はし}ってく",
      "zh": "人生就是挑战，你我找到梦想，奔跑向前",
      "aside": false
    },
    {
      "markup": "絆{きずな}|を|胸{むね}|に、|ね？　|まだまだ|挑戦{ちょうせん}|だ|よ",
      "zh": "把羁绊放在心中，好吗？还要继续挑战啊",
      "aside": false
    },
    {
      "markup": "ひとりひとり|の|願{ねが}い|が　|輝{かがや}いてる|みたいな",
      "zh": "仿佛每个人的心愿都在闪耀的",
      "aside": false
    },
    {
      "markup": "海{うみ}|よ！",
      "zh": "大海啊！",
      "aside": false
    },
    {
      "markup": "ここ|で|受{う}けとった　|ここ|で|手放{てばな}した|涙{なみだ}　|忘{わす}れない",
      "zh": "在这里接住的、在这里放下的泪水，我不会忘记",
      "aside": false
    },
    {
      "markup": "ひとりひとり|の|願{ねが}い|が　|輝{かがや}いて|波{なみ}|が|踊{おど}ってる",
      "zh": "每个人的心愿闪耀着，海浪也在起舞",
      "aside": false
    },
    {
      "markup": "僕{ぼく}ら|も|踊{おど}ろう　|離{はな}れてても|いい|さ",
      "zh": "我们也起舞吧，就算相隔两地也没关系",
      "aside": false
    },
    {
      "markup": "大丈夫{だいじょうぶ}|伝{つた}わっちゃう|よ！",
      "zh": "没关系，心意会传达过去的！",
      "aside": false
    },
    {
      "markup": "僕{ぼく}ら|の|海{うみ}|よ　|いつも|の|海{うみ}|よ　|去{さ}ってく|時代{とき}|よ　|波{なみ}|よ",
      "zh": "我们的海啊，熟悉的海啊，逝去的时光啊，海浪啊",
      "aside": false
    },
    {
      "markup": "一瞬{いっしゅん}|だ|けど|さ　|瞬間{しゅんかん}|だから|忘{わす}れられない|こと|も|ある",
      "zh": "虽然只有一瞬，也有正因为短暂才无法忘怀的事",
      "aside": false
    },
    {
      "markup": "目{め}|に|見{み}える|こと|だけ|じゃなくて…",
      "zh": "不只是眼睛能够看见的那些……",
      "aside": false
    },
    {
      "markup": "ひとりひとり|の|願{ねが}い|が　|輝{かがや}いてる|みたいな",
      "zh": "仿佛每个人的心愿都在闪耀的",
      "aside": false
    },
    {
      "markup": "海{うみ}|よ！",
      "zh": "大海啊！",
      "aside": false
    },
    {
      "markup": "ここ|で|また|会{あ}う|んだ　|ここ|で|また|会{あ}う|んだ　|きっと|ね|また|会{あ}おう",
      "zh": "我们会在这里再相见，会在这里再相见，一定要再相会啊",
      "aside": false
    },
    {
      "markup": "みんな|みんな|楽{たの}しい|こと　|探{さが}す|旅{たび}|の|途中{とちゅう}|なんだ",
      "zh": "大家都在寻找快乐的旅途中啊",
      "aside": false
    },
    {
      "markup": "たくさん|冒険{ぼうけん}|して　|次{つぎ}|に|語{かた}りあえる|時{とき}|が",
      "zh": "经历许多冒险后，下次能与彼此畅谈的时刻",
      "aside": false
    },
    {
      "markup": "待ち遠しい{まちどおしい}|よ！",
      "zh": "真让人迫不及待啊！",
      "aside": false
    }
  ],
